[Unit]
Description=MeshBot Meshtastic service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/github/meshbot
ExecStart=%h/github/meshbot/.venv/bin/python -m meshbot
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
